# ——— REQUIRED everywhere, including local dev ———
# Postgres only (schema is postgresql) — Neon free tier recommended: https://neon.tech
# Use the POOLED connection string (not the direct one) since Next.js serverless
# functions open many short-lived connections: "...?sslmode=require&pgbouncer=true"
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"

# JWT_SECRET: generate a long random string (min 16 chars, 32+ recommended).
# Can be omitted only in NODE_ENV=development (a fixed dev secret is used).
JWT_SECRET="generate-a-long-random-string-min-32-chars"

# ——— AI (optional) ———
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ——— Freemium ———
FREE_AI_MONTHLY_LIMIT=10

# ——— Telegram bot (quick entry + notifications) ———
# 1) Create a bot with @BotFather and copy its token.
# 2) Run:  node scripts/telegram-setup.mjs <token> https://your-domain
#    It registers the webhook, the command list and the menu button, and prints these values.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=
# Vercel Cron calls /api/cron/daily (evening digest) with "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET=

# ——— Rate limit (production: Upstash Redis) ———
# Without Redis, limits are in-memory and reset on cold start.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ——— OAuth (Week 1 roadmap: Auth.js / Clerk) ———
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
