# ——— REQUIRED in production ———
JWT_SECRET="generate-a-long-random-string-min-32-chars"
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ——— Local dev (optional SQLite only if you switch schema back) ———
# DATABASE_URL="postgresql://..."   # Neon / Supabase / Railway
# JWT_SECRET can be omitted only in NODE_ENV=development

# ——— AI (optional) ———
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ——— Freemium ———
FREE_AI_MONTHLY_LIMIT=10

# ——— Telegram ———
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# ——— Rate limit (production: Upstash Redis) ———
# Without Redis, limits are in-memory and reset on cold start.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ——— OAuth (Week 1 roadmap: Auth.js / Clerk) ———
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
