// MoneyPulse — Postgres (Neon/Supabase) or local SQLite
// DATABASE_URL="postgresql://..."  or  "file:./dev.db"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String?
  salt             String?
  plan             String    @default("free") // free | pro | demo
  aiUsedMonth      Int       @default(0)
  aiMonthKey       String    @default("") // YYYY-MM
  image            String?
  telegramId       String?   @unique
  telegramLinkedAt DateTime?
  // Telegram notifications (budget alerts, family chat, evening summary) — on by default once linked.
  tgNotify         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts     Account[]
  transactions Transaction[]
  goals        Goal[]
  budgets      Budget[]
  settings     UserSettings?
  familyMember FamilyMember?
}

model Family {
  id            String         @id @default(cuid())
  name          String
  inviteCode    String         @unique
  ownerId       String
  createdAt     DateTime       @default(now())
  members       FamilyMember[]
  familyBudgets FamilyBudget[]
  familyGoals   FamilyGoal[]
  messages      FamilyMessage[]
}

model FamilyMessage {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId     String
  // Snapshot — the message stays readable after its author leaves the family.
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([familyId, createdAt])
}

model FamilyBudget {
  id        String @id @default(cuid())
  familyId  String
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category  String
  limit     Float
  period    String @default("month")
  createdBy String

  @@unique([familyId, category])
}

model FamilyGoal {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      String?
  emoji         String   @default("🎯")
  createdBy     String
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // "owner" | "member"
  joinedAt DateTime @default(now())

  @@index([familyId])
}

// One-time code shown in Settings; the user sends it to the bot as /start <code> to link the chat.
model TelegramLinkCode {
  code      String   @id
  userId    String
  expiresAt DateTime

  @@index([userId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("pricing")
  createdAt DateTime @default(now())
}

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency              String  @default("сум")
  monthlyIncomeGoal     Float?
  savingsTargetPercent  Int     @default(20)
  notifications         Boolean @default(false)
  theme                 String  @default("dark")
  streak                Int     @default(0)
  bestStreak            Int     @default(0)
  lastLogDate           String  @default("")
  badgesJson            String  @default("[]")
  customCategoriesJson  String  @default("[]")
}

model Account {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  type    String  // cash | bank | card | savings | other
  balance Float   @default(0)
  emoji   String?

  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String  // income | expense
  amount      Float
  category    String
  description String
  date        String
  recurring   Boolean  @default(false)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  tagsJson    String   @default("[]")
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model Goal {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Float
  currentAmount Float   @default(0)
  deadline      String?
  emoji         String  @default("🎯")
  color         String?

  @@index([userId])
}

model Budget {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  limit    Float
  period   String @default("month")

  @@unique([userId, category])
}
